# =============================================================================
# SeptaTyper production settings. Copy to the server, replace every CHANGE_ME,
# and keep this file out of Git (it is listed in .dockerignore and .gitignore).
# No quotes around values.
# =============================================================================

# --- Public address (Caddy) ---------------------------------------------------
# DNS A/AAAA record for this name must already point at the server.
API_DOMAIN=api.example.org
ACME_EMAIL=you@example.org

# --- PostgreSQL ---------------------------------------------------------------
POSTGRES_USER=septatyper
POSTGRES_PASSWORD=CHANGE_ME_openssl_rand_hex_24
POSTGRES_DB=septatyper
POSTGRES_HOST=db
# DATABASE_URL is built automatically from the values above (password URL-encoded).
# Set it only to point the API at an external database, e.g.
# DATABASE_URL=postgresql+psycopg2://user:password@host:5432/septatyper

# --- Authentication (curator login) -------------------------------------------
# 32 or more random characters. The API refuses to start without it.
#   openssl rand -hex 32
SEPTATYPER_JWT_SECRET=CHANGE_ME_openssl_rand_hex_32
SEPTATYPER_TOKEN_TTL=28800
SEPTATYPER_LOGIN_LIMIT=10

# --- CORS: the exact origin(s) of the website, comma separated, no trailing slash
FRONTEND_ORIGINS=https://your-project.vercel.app

# --- Prediction engine --------------------------------------------------------
# Reference FASTAs are mounted read-only from ./references (see DEPLOYMENT.md).
SEPTATYPER_REF_DIR=/app/references
BLASTN_PATH=blastn
MAKEBLASTDB_PATH=makeblastdb
SEPTATYPER_THREADS=2
SEPTATYPER_MAX_CONCURRENT=2

# --- Uploads and submissions --------------------------------------------------
SEPTATYPER_MAX_UPLOAD_BYTES=62914560
SEPTATYPER_SUBMISSION_DIR=/data/submissions
SEPTATYPER_SUBMIT_LIMIT=10
# 1 only because Caddy is the sole way in; it makes rate limits use the visitor IP.
SEPTATYPER_TRUST_PROXY=1

# --- BV-BRC -------------------------------------------------------------------
BVBRC_API_BASE=https://www.bv-brc.org/api
